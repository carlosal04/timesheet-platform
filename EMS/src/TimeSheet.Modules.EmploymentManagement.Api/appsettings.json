{
  "ConnectionStrings": {
    "EmploymentManagement": "Host=localhost;Port=54329;Database=ems;Username=ems;Password=SET_LOCAL_DB_PASSWORD"
  },
  "Authentication": {
    "CookieName": "ems.auth",
    "SessionLifetimeMinutes": 480,
    "LockoutThreshold": 5,
    "LockoutMinutes": 15
  },
  "BootstrapAdmin": {
    "Email": "",
    "Password": "",
    "Name": "Bootstrap Admin"
  },
  "DataProtection": {
    "KeysPath": "../../.local/data-protection-keys"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "https://localhost:5173",
      "https://127.0.0.1:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Properties": {
      "Application": "TimeSheet.Modules.EmploymentManagement.Api",
      "Module": "EMS"
    }
  },
  "AllowedHosts": "*"
}
